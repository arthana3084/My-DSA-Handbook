#include<bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<string> AllPossibleStrings(string s) {

        int n = s.length();
        vector<string> ans;

        for(int mask = 1; mask < (1 << n); mask++){

            string temp = "";

            for(int i = 0; i < n; i++){

                if(mask & (1 << i))
                    temp += s[i];
            }

            ans.push_back(temp);
        }

        sort(ans.begin(), ans.end());

        return ans;
    }
};

