#include<bits/stdc++.h>
using namespace std;

class Solution {
public:
    void bitManipulation(int num, int i) {

        int bit = (num >> (i - 1)) & 1;
        int setBit = num | (1 << (i - 1));
        int clearBit = num & (~(1 << (i - 1)));

        cout << bit << " " << setBit << " " << clearBit;
    }
};

