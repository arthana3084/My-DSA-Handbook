#include<bits/stdc++.h>
using namespace std;

class Solution
{
public:

    //================ Memoization ================//

    int solve(int n, vector<int>& dp)
    {
        if(n <= 1)
            return n;

        if(dp[n] != -1)
            return dp[n];

        return dp[n] = solve(n - 1, dp) + solve(n - 2, dp);
    }

    int fibMemo(int n)
    {
        vector<int> dp(n + 1, -1);
        return solve(n, dp);
    }

    //================ Tabulation ================//

    int fibTab(int n)
    {
        if(n <= 1)
            return n;

        vector<int> dp(n + 1);

        dp[0] = 0;
        dp[1] = 1;

        for(int i = 2; i <= n; i++)
            dp[i] = dp[i - 1] + dp[i - 2];

        return dp[n];
    }

    //========== Space Optimized (Best) ==========//

    int fib(int n)
    {
        if(n <= 1)
            return n;

        int prev2 = 0;
        int prev1 = 1;

        for(int i = 2; i <= n; i++)
        {
            int curr = prev1 + prev2;
            prev2 = prev1;
            prev1 = curr;
        }

        return prev1;
    }
};

