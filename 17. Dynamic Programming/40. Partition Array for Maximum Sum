*/

#include<bits/stdc++.h>
using namespace std;

class Solution {
public:

    //================ Memoization ================

    int solve(int ind,
              vector<int>& arr,
              int k,
              vector<int>& dp){

        int n=arr.size();

        if(ind==n)
            return 0;

        if(dp[ind]!=-1)
            return dp[ind];

        int len=0;
        int maxi=INT_MIN;
        int ans=INT_MIN;

        for(int j=ind;j<min(n,ind+k);j++){

            len++;

            maxi=max(maxi,arr[j]);

            ans=max(ans,
                    len*maxi+
                    solve(j+1,arr,k,dp));
        }

        return dp[ind]=ans;
    }

    int maxSumAfterPartitioningMemo(vector<int>& arr,
                                    int k){

        vector<int> dp(arr.size(),-1);

        return solve(0,arr,k,dp);
    }

    //================ Tabulation ================

    int maxSumAfterPartitioning(vector<int>& arr,
                                int k){

        int n=arr.size();

        vector<int> dp(n+1,0);

        for(int ind=n-1;ind>=0;ind--){

            int len=0;
            int maxi=INT_MIN;
            int ans=INT_MIN;

            for(int j=ind;j<min(n,ind+k);j++){

                len++;

                maxi=max(maxi,arr[j]);

                ans=max(ans,
                        len*maxi+
                        dp[j+1]);
            }

            dp[ind]=ans;
        }

        return dp[0];
    }
};

