Problem      : Frog Jump
Platform     : Coding Ninjas

Difficulty   : Easy

Pattern      : 1D Dynamic Programming

Approaches:
1. Memoization
2. Tabulation
3. Space Optimization ⭐

Time          : O(n)
Space         : O(n) / O(1)

Status              : ⭐ Must Revise
Frequently Asked    : ⭐⭐⭐⭐⭐
==================================================
*/

#include<bits/stdc++.h>
using namespace std;

class Solution
{
public:

    //================ Memoization ================//

    int solve(int idx, vector<int>& h, vector<int>& dp)
    {
        if(idx == 0)
            return 0;

        if(dp[idx] != -1)
            return dp[idx];

        int left = solve(idx - 1, h, dp) + abs(h[idx] - h[idx - 1]);

        int right = INT_MAX;

        if(idx > 1)
            right = solve(idx - 2, h, dp) + abs(h[idx] - h[idx - 2]);

        return dp[idx] = min(left, right);
    }

    int frogJumpMemo(int n, vector<int>& heights)
    {
        vector<int> dp(n, -1);
        return solve(n - 1, heights, dp);
    }

    //================ Tabulation ================//

    int frogJumpTab(int n, vector<int>& h)
    {
        vector<int> dp(n);

        dp[0] = 0;

        for(int i = 1; i < n; i++)
        {
            int left = dp[i - 1] + abs(h[i] - h[i - 1]);

            int right = INT_MAX;

            if(i > 1)
                right = dp[i - 2] + abs(h[i] - h[i - 2]);

            dp[i] = min(left, right);
        }

        return dp[n - 1];
    }

    //========== Space Optimized (Best) ==========//

    int frogJump(int n, vector<int>& h)
    {
        int prev = 0;
        int prev2 = 0;

        for(int i = 1; i < n; i++)
        {
            int left = prev + abs(h[i] - h[i - 1]);

            int right = INT_MAX;

            if(i > 1)
                right = prev2 + abs(h[i] - h[i - 2]);

            int curr = min(left, right);

            prev2 = prev;
            prev = curr;
        }

        return prev;
    }
};

