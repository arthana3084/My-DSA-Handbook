*/

#include<bits/stdc++.h>
using namespace std;

class Solution {
public:

    //================ Memoization ================

    int solve(int ind,int buy,vector<int>& prices,
              int fee,vector<vector<int>>& dp){

        if(ind==prices.size())
            return 0;

        if(dp[ind][buy]!=-1)
            return dp[ind][buy];

        if(buy){

            return dp[ind][buy]=max(
                -prices[ind]+solve(ind+1,0,prices,fee,dp),
                solve(ind+1,1,prices,fee,dp));
        }

        return dp[ind][buy]=max(
            prices[ind]-fee+
            solve(ind+1,1,prices,fee,dp),
            solve(ind+1,0,prices,fee,dp));
    }

    int maxProfitMemo(vector<int>& prices,int fee){

        int n=prices.size();

        vector<vector<int>> dp(n,vector<int>(2,-1));

        return solve(0,1,prices,fee,dp);
    }

    //================ Tabulation ================

    int maxProfitTab(vector<int>& prices,int fee){

        int n=prices.size();

        vector<vector<int>> dp(n+1,vector<int>(2,0));

        for(int ind=n-1;ind>=0;ind--){

            dp[ind][1]=max(
                -prices[ind]+dp[ind+1][0],
                dp[ind+1][1]);

            dp[ind][0]=max(
                prices[ind]-fee+dp[ind+1][1],
                dp[ind+1][0]);
        }

        return dp[0][1];
    }

    //============= Space Optimization =============

    int maxProfit(vector<int>& prices,int fee){

        vector<int> ahead(2,0),curr(2,0);

        for(int ind=prices.size()-1;ind>=0;ind--){

            curr[1]=max(
                -prices[ind]+ahead[0],
                ahead[1]);

            curr[0]=max(
                prices[ind]-fee+ahead[1],
                ahead[0]);

            ahead=curr;
        }

        return ahead[1];
    }
};

