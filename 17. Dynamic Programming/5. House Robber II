#include<bits/stdc++.h>
using namespace std;

class Solution
{
public:

    int solve(vector<int>& nums)
    {
        int prev = nums[0];
        int prev2 = 0;

        for(int i = 1; i < nums.size(); i++)
        {
            int pick = nums[i];

            if(i > 1)
                pick += prev2;

            int curr = max(pick, prev);

            prev2 = prev;
            prev = curr;
        }

        return prev;
    }

    int rob(vector<int>& nums)
    {
        int n = nums.size();

        if(n == 1)
            return nums[0];

        vector<int> first(nums.begin(), nums.end() - 1);
        vector<int> second(nums.begin() + 1, nums.end());

        return max(solve(first), solve(second));
    }
};

