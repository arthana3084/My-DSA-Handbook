#include<bits/stdc++.h>
using namespace std;

class Solution {
public:

    //================ Memoization ================

    int solve(int i,int j,vector<vector<int>>& triangle,
              vector<vector<int>>& dp){

        int n=triangle.size();

        if(i==n-1)
            return triangle[i][j];

        if(dp[i][j]!=-1)
            return dp[i][j];

        int down=triangle[i][j]+solve(i+1,j,triangle,dp);
        int diag=triangle[i][j]+solve(i+1,j+1,triangle,dp);

        return dp[i][j]=min(down,diag);
    }

    int minimumTotalMemo(vector<vector<int>>& triangle){

        int n=triangle.size();
        vector<vector<int>> dp(n,vector<int>(n,-1));

        return solve(0,0,triangle,dp);
    }

    //================ Tabulation ================

    int minimumTotalTab(vector<vector<int>>& triangle){

        int n=triangle.size();
        vector<vector<int>> dp(n,vector<int>(n));

        for(int j=0;j<n;j++)
            dp[n-1][j]=triangle[n-1][j];

        for(int i=n-2;i>=0;i--){

            for(int j=i;j>=0;j--){

                dp[i][j]=triangle[i][j]+
                         min(dp[i+1][j],dp[i+1][j+1]);
            }
        }

        return dp[0][0];
    }

    //============= Space Optimization =============

    int minimumTotal(vector<vector<int>>& triangle){

        int n=triangle.size();

        vector<int> front=triangle[n-1];

        for(int i=n-2;i>=0;i--){

            vector<int> curr(n);

            for(int j=i;j>=0;j--){

                curr[j]=triangle[i][j]+
                        min(front[j],front[j+1]);
            }

            front=curr;
        }

        return front[0];
    }
};

