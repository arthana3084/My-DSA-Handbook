#include<bits/stdc++.h>
using namespace std;

class Solution {
public:

    //================ Memoization ================

    int solve(int i,int j1,int j2,
              vector<vector<int>>& grid,
              vector<vector<vector<int>>>& dp){

        int r=grid.size(), c=grid[0].size();

        if(j1<0||j2<0||j1>=c||j2>=c)
            return -1e9;

        if(i==r-1){

            if(j1==j2) return grid[i][j1];
            return grid[i][j1]+grid[i][j2];
        }

        if(dp[i][j1][j2]!=-1)
            return dp[i][j1][j2];

        int ans=-1e9;

        for(int dj1=-1;dj1<=1;dj1++){

            for(int dj2=-1;dj2<=1;dj2++){

                int value=(j1==j2)?
                    grid[i][j1]:
                    grid[i][j1]+grid[i][j2];

                value+=solve(i+1,j1+dj1,j2+dj2,grid,dp);

                ans=max(ans,value);
            }
        }

        return dp[i][j1][j2]=ans;
    }

    int cherryPickup(vector<vector<int>>& grid){

        int r=grid.size();
        int c=grid[0].size();

        vector<vector<vector<int>>> dp(
            r,vector<vector<int>>(c,vector<int>(c,-1)));

        return solve(0,0,c-1,grid,dp);
    }
};

