#include<bits/stdc++.h>
using namespace std;

class Solution {
public:

    vector<int> dijkstra(int V, vector<vector<int>> adj[], int S){

        priority_queue<pair<int,int>,
                       vector<pair<int,int>>,
                       greater<pair<int,int>>> pq;

        vector<int> dist(V, INT_MAX);

        dist[S] = 0;
        pq.push({0,S});

        while(!pq.empty()){

            auto it = pq.top();
            pq.pop();

            int dis = it.first;
            int node = it.second;

            for(auto edge : adj[node]){

                int adjNode = edge[0];
                int wt = edge[1];

                if(dis + wt < dist[adjNode]){

                    dist[adjNode] = dis + wt;
                    pq.push({dist[adjNode], adjNode});
                }
            }
        }

        return dist;
    }
};

