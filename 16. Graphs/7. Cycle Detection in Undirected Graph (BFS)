==================================================
*/

#include<bits/stdc++.h>
using namespace std;

class Solution {
  public:

    bool bfs(int src, vector<vector<int>>& adj, vector<bool>& vis){

        queue<pair<int,int>> q;
        q.push({src,-1});
        vis[src] = true;

        while(!q.empty()){

            auto [node,parent] = q.front();
            q.pop();

            for(int it : adj[node]){

                if(!vis[it]){
                    vis[it] = true;
                    q.push({it,node});
                }
                else if(it != parent){
                    return true;
                }
            }
        }

        return false;
    }

    bool isCycle(vector<vector<int>>& adj){

        int V = adj.size();
        vector<bool> vis(V,false);

        for(int i=0;i<V;i++){

            if(!vis[i] && bfs(i,adj,vis))
                return true;
        }

        return false;
    }
};

