#include<bits/stdc++.h>
using namespace std;

class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {

        int V = adj.size();

        vector<int> ans;
        vector<bool> vis(V, false);

        queue<int> q;

        q.push(0);
        vis[0] = true;

        while(!q.empty()){

            int node = q.front();
            q.pop();

            ans.push_back(node);

            for(int it : adj[node]){

                if(!vis[it]){

                    vis[it] = true;
                    q.push(it);
                }
            }
        }

        return ans;
    }
};

