#include<bits/stdc++.h>
using namespace std;

class DisjointSet{
public:

    vector<int> parent,size;

    DisjointSet(int n){

        parent.resize(n);
        size.resize(n,1);

        for(int i=0;i<n;i++)
            parent[i]=i;
    }

    int findUPar(int node){

        if(node==parent[node])
            return node;

        return parent[node]=findUPar(parent[node]);
    }

    void unionBySize(int u,int v){

        u=findUPar(u);
        v=findUPar(v);

        if(u==v) return;

        if(size[u]<size[v]){

            parent[u]=v;
            size[v]+=size[u];
        }
        else{

            parent[v]=u;
            size[u]+=size[v];
        }
    }
};

class Solution {
public:

    int makeConnected(int n, vector<vector<int>>& connections) {

        if(connections.size()<n-1)
            return -1;

        DisjointSet ds(n);

        for(auto &it:connections)
            ds.unionBySize(it[0],it[1]);

        int components=0;

        for(int i=0;i<n;i++){

            if(ds.findUPar(i)==i)
                components++;
        }

        return components-1;
    }
};

